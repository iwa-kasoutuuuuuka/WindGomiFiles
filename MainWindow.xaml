<Window x:Class="WinGomiExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:WinGomiExplorer.Converters"
        mc:Ignorable="d"
        Title="WinGomiExplorer - 容量ソート対応タブ型ファイルエクスプローラー &amp; 大容量ゴミファイルスキャナー"
        Width="1380" Height="860"
        MinWidth="1020" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Background="#0B1120"
        Foreground="#F8FAFC"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <conv:RatioToWidthConverter x:Key="RatioToWidthConverter" MaxWidth="160"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:CategoryToBackgroundConverter x:Key="CategoryBgConverter"/>
        <conv:CategoryToForegroundConverter x:Key="CategoryFgConverter"/>

        <!-- 共通ボタンスタイル -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0369A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#F87171"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 上部：ドライブ容量モニター＆クイックスキャンバー ==================== -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel>
                <!-- アプリタイトル・特徴バッジ -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Image Source="pack://application:,,,/Assets/app_icon.png"
                           Width="38" Height="38"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="WinGomiExplorer" FontSize="17" FontWeight="Bold" Foreground="#38BDF8"/>
                            <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Win11 容量順ソート &amp; ゴミ抽出" FontSize="10.5" Foreground="#93C5FD" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="拡張子・隠しファイル(H)・システム保護(S) 常時全表示" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 右側アクションボタン -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource AccentButton}"
                            Content="🔍 Cドライブ大容量・ゴミ抽出スキャン"
                            Padding="12,7"
                            Click="ScanCDriveButton_Click"/>
                    <Button Style="{StaticResource ModernButton}"
                            Content="🔄 ドライブ更新"
                            Margin="8,0,0,0"
                            Padding="10,7"
                            Click="RefreshDrivesButton_Click"/>
                </StackPanel>

                <!-- ドライブカード一覧 -->
                <ItemsControl x:Name="DrivesItemsControl" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                    CornerRadius="6" Padding="10,6" Margin="0,0,10,0" Width="265">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="12.5" Foreground="#F8FAFC"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="開く" Style="{StaticResource ModernButton}"
                                                    Padding="6,1" FontSize="11" Margin="0,0,4,0"
                                                    Tag="{Binding RootPath}" Click="OpenDriveButton_Click"/>
                                            <Button Content="🔍スキャン" Style="{StaticResource AccentButton}"
                                                    Padding="6,1" FontSize="11"
                                                    Tag="{Binding RootPath}" Click="ScanDriveButton_Click"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar Value="{Binding UsedPercentage, Mode=OneWay}" Maximum="100" Height="6"
                                                 Margin="0,5,0,4" Background="#0F172A" BorderThickness="0">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Foreground" Value="#38BDF8"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLowSpace}" Value="True">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                    <TextBlock Text="{Binding UsageSummary}" FontSize="10.5" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- ==================== 中央：左サイドバー ＋ マルチタブ領域 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235" MinWidth="180" MaxWidth="360"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左サイドバー：クイックアクセス & 隠しゴミ溜まりスポット直通 -->
            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="📌 クイックアクセス &amp; 隠し領域"
                               FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="4,4,4,8"/>

                    <ListBox x:Name="QuickAccessListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#E2E8F0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseUp="QuickAccessListBox_MouseUp">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,5"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#1E3A8A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel ToolTip="{Binding TargetPath}">
                                    <TextBlock Text="{Binding Icon}" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📂 現在のタブで開く" Click="QuickAccessOpenCurrentTab_Click"/>
                                <MenuItem Header="➕ 新しいタブで開く" Click="QuickAccessOpenNewTab_Click"/>
                                <MenuItem Header="🔍 この場所を大容量スキャン" Click="QuickAccessScan_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#1E293B"/>

            <!-- 右側メイン：タブバー ＋ アクティブタブコンテンツ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. タブバー -->
                <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="8,6,8,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,4">
                            <Button Style="{StaticResource ModernButton}"
                                    Content="＋ 新規フォルダタブ"
                                    Padding="9,4" FontSize="12" Margin="0,0,6,0"
                                    Click="NewExplorerTabButton_Click"/>
                            <Button Style="{StaticResource AccentButton}"
                                    Content="🔍＋ 大容量スキャンタブ"
                                    Padding="9,4" FontSize="12"
                                    Click="NewScannerTabButton_Click"/>
                        </StackPanel>

                        <ListBox x:Name="TabsListBox"
                                 ItemsSource="{Binding Tabs}"
                                 SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,4,0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="tabBorder"
                                                        Background="#1E293B"
                                                        BorderBrush="#334155"
                                                        BorderThickness="1,1,1,0"
                                                        CornerRadius="6,6,0,0"
                                                        Padding="12,6"
                                                        Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="tabBorder" Property="Background" Value="#0284C7"/>
                                                        <Setter TargetName="tabBorder" Property="BorderBrush" Value="#38BDF8"/>
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                            <Condition Property="IsSelected" Value="False"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="tabBorder" Property="Background" Value="#334155"/>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" MaxWidth="240">
                                        <TextBlock Text="{Binding HeaderTitle}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="195"
                                                   ToolTip="{Binding CurrentPath}"/>
                                        <Button Content="✕"
                                                Margin="8,0,0,0"
                                                Padding="4,0"
                                                Background="Transparent"
                                                Foreground="#E2E8F0"
                                                BorderThickness="0"
                                                FontSize="11"
                                                Cursor="Hand"
                                                Tag="{Binding}"
                                                Click="CloseTabButton_Click"
                                                ToolTip="タブを閉じる"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- 2. ナビゲーション＆アドレスバー (アクティブタブにバインド) -->
                <Border Grid.Row="1" Background="#162032" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="10,8"
                        DataContext="{Binding ActiveTab}">
                    <Grid>
                        <!-- フォルダ閲覧タブ用ナビゲーション -->
                        <DockPanel Visibility="{Binding IsExplorerTab, Converter={StaticResource BoolToVis}}">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,8,0">
                                <Button Style="{StaticResource ModernButton}" Content="⬅" Width="34" Margin="0,0,4,0"
                                        IsEnabled="{Binding CanGoBack}" Click="BackButton_Click" ToolTip="戻る"/>
                                <Button Style="{StaticResource ModernButton}" Content="➡" Width="34" Margin="0,0,4,0"
                                        IsEnabled="{Binding CanGoForward}" Click="ForwardButton_Click" ToolTip="進む"/>
                                <Button Style="{StaticResource ModernButton}" Content="⬆ 上へ" Padding="8,5" Margin="0,0,4,0"
                                        IsEnabled="{Binding CanGoUp}" Click="UpButton_Click" ToolTip="上の階層へ"/>
                                <Button Style="{StaticResource ModernButton}" Content="🔄 容量再計算" Padding="8,5"
                                        Click="RefreshExplorerButton_Click" ToolTip="最新状態に更新しフォルダ容量を再計算"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Style="{StaticResource ModernButton}" Content="移動" Padding="12,5" Margin="0,0,6,0"
                                        Click="NavigateAddressButton_Click"/>
                                <Button Style="{StaticResource AccentButton}" Content="🔍 このフォルダを大容量スキャン" Padding="12,5"
                                        Click="ScanCurrentFolderButton_Click"/>
                            </StackPanel>

                            <TextBox x:Name="ExplorerAddressTextBox"
                                     Text="{Binding AddressBarText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"
                                     Padding="8,5" FontSize="13" VerticalContentAlignment="Center"
                                     KeyDown="ExplorerAddressTextBox_KeyDown"/>
                        </DockPanel>

                        <!-- 大容量・ゴミファイルスキャンタブ用ナビゲーション -->
                        <DockPanel Visibility="{Binding IsScannerTab, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Left" Text="🎯 スキャン対象パス:" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,8,0"/>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Style="{StaticResource AccentButton}" Content="🚀 スキャン開始 / 再スキャン" Padding="14,5" Margin="0,0,6,0"
                                        Click="StartScanButton_Click"/>
                                <Button Style="{StaticResource DangerButton}" Content="⏹ 停止" Padding="12,5"
                                        IsEnabled="{Binding IsBusy}" Click="StopScanButton_Click"/>
                            </StackPanel>

                            <TextBox Text="{Binding AddressBarText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#38BDF8"
                                     Padding="8,5" FontSize="13" VerticalContentAlignment="Center"
                                     KeyDown="ScannerAddressTextBox_KeyDown"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- 3. ソート・フィルタ・モード切替バー -->
                <Border Grid.Row="2" Background="#111827" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="10,7"
                        DataContext="{Binding ActiveTab}">
                    <DockPanel>
                        <!-- 右側：リアルタイム検索ボックス -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔎 絞り込み:" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                     Width="210" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"
                                     Padding="6,4" FontSize="12" VerticalContentAlignment="Center"
                                     ToolTip="ファイル名・拡張子・パス・判定ラベルでリアルタイム絞り込み"/>
                        </StackPanel>

                        <!-- 左側：エクスプローラータブ用ソートバー -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsExplorerTab, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="並び替え:" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource AccentButton}" Content="⬇ 容量が大きい順 (フォルダ含む)"
                                    Padding="10,4" Margin="0,0,5,0" FontSize="12" Click="SortBySizeDescButton_Click"/>
                            <Button Style="{StaticResource ModernButton}" Content="🔤 名前順"
                                    Padding="8,4" Margin="0,0,5,0" FontSize="12" Click="SortByNameButton_Click"/>
                            <Button Style="{StaticResource ModernButton}" Content="🏷️ 拡張子順"
                                    Padding="8,4" Margin="0,0,5,0" FontSize="12" Click="SortByExtensionButton_Click"/>
                            <Button Style="{StaticResource ModernButton}" Content="🕒 更新日時順"
                                    Padding="8,4" Margin="0,0,12,0" FontSize="12" Click="SortByDateButton_Click"/>

                            <CheckBox IsChecked="{Binding SortFoldersFirst}"
                                      Content="フォルダを上部にまとめる"
                                      Foreground="#E2E8F0" VerticalAlignment="Center" FontSize="12" Margin="0,0,14,0"
                                      ToolTip="オフにするとフォルダもファイルも純粋に容量の大きい順で並べて比較できます"/>

                            <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                <TextBlock Text="✓ 拡張子・隠しファイル・システムファイル全表示中" FontSize="11" Foreground="#6EE7B7"/>
                            </Border>
                        </StackPanel>

                        <!-- 左側：大容量スキャンタブ用フィルタバー -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsScannerTab, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="表示モード:" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12" Margin="0,0,8,0"/>

                            <RadioButton Content="📄 巨大ファイル Topランキング"
                                         IsChecked="{Binding IsLargeFilesMode}"
                                         Foreground="#F8FAFC" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <RadioButton Content="📁 巨大フォルダ Topランキング"
                                         IsChecked="{Binding IsLargeFoldersMode}"
                                         Foreground="#F8FAFC" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <RadioButton Content="🧹 ゴミ・一時ファイル・キャッシュ候補のみ"
                                         IsChecked="{Binding IsJunkMode}"
                                         Foreground="#FBBF24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,18,0"/>

                            <TextBlock Text="最小サイズ:" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding ThresholdOptions}"
                                      SelectedValue="{Binding MinSizeThresholdBytes}"
                                      SelectedValuePath="Bytes"
                                      DisplayMemberPath="Label"
                                      Width="145" FontSize="12" Padding="6,3"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 4. メイン DataGrid (ファイル・フォルダ一覧) -->
                <DataGrid Grid.Row="3"
                          x:Name="ItemsDataGrid"
                          DataContext="{Binding ActiveTab}"
                          ItemsSource="{Binding DisplayedItems}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="False"
                          SelectionMode="Extended"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#1E293B"
                          Background="#0B1120"
                          RowBackground="#0F172A"
                          AlternatingRowBackground="#131C31"
                          Foreground="#F1F5F9"
                          BorderThickness="0"
                          RowHeight="32"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          Sorting="ItemsDataGrid_Sorting"
                          MouseDoubleClick="ItemsDataGrid_MouseDoubleClick">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="Foreground" Value="#CBD5E1"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="10,7"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1E3A8A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="📂 開く / フォルダへ移動" Click="ContextOpen_Click"/>
                            <MenuItem Header="➕ 新しいタブでこの場所を開く" Click="ContextOpenInNewTab_Click"/>
                            <MenuItem Header="🔍 このフォルダを大容量スキャン" Click="ContextScanFolder_Click"/>
                            <Separator/>
                            <MenuItem Header="📋 フルパスをコピー" Click="ContextCopyPath_Click"/>
                            <MenuItem Header="🪟 Windows標準エクスプローラーで場所を開く" Click="ContextRevealInExplorer_Click"/>
                            <Separator/>
                            <MenuItem Header="🔥 この項目を完全削除する..." Foreground="#DC2626" FontWeight="Bold" Click="ContextDeletePermanent_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <!-- 選択チェックボックス -->
                        <DataGridTemplateColumn Header="選択" Width="46" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsSystemProtected, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ToolTip="削除対象として選択（システム保護項目は選択不可）"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 名前 (アイコン + 拡張子込みフルネーム) -->
                        <DataGridTemplateColumn Header="名前 (拡張子常時表示)" Width="290" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                        <TextBlock Text="{Binding IconSymbol}" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FullPath}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#F8FAFC"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                            <Setter Property="Foreground" Value="#93C5FD"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 拡張子 -->
                        <DataGridTextColumn Header="拡張子" Binding="{Binding Extension}" Width="85" SortMemberPath="Extension" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                    <Setter Property="Foreground" Value="#38BDF8"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- サイズ & 視覚的容量バー -->
                        <DataGridTemplateColumn Header="容量 (サイズ順ソート対応)" Width="180" SortMemberPath="Size">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,3" VerticalAlignment="Center">
                                        <!-- 背景容量バー -->
                                        <Border HorizontalAlignment="Left"
                                                Width="{Binding SizeRatio, Converter={StaticResource RatioToWidthConverter}}"
                                                Height="20"
                                                CornerRadius="3"
                                                Background="#3B0764"
                                                BorderBrush="#A855F7"
                                                BorderThickness="1"
                                                Opacity="0.65"/>
                                        <!-- サイズテキスト -->
                                        <TextBlock Text="{Binding SizeDisplay}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,8,0"
                                                   FontWeight="Bold"
                                                   FontSize="12.5"
                                                   Foreground="#F8FAFC"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 種別 / ゴミ・保護判定 -->
                        <DataGridTemplateColumn Header="種別・ゴミ判定" Width="145" SortMemberPath="Category">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Category, Converter={StaticResource CategoryBgConverter}}"
                                            CornerRadius="4" Padding="7,2" Margin="6,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CategoryLabel}"
                                                   Foreground="{Binding Category, Converter={StaticResource CategoryFgConverter}}"
                                                   FontSize="11.5" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 属性 (隠し・システム・読取専用・リンク) -->
                        <DataGridTextColumn Header="属性 (H/S/R/L)" Binding="{Binding AttributesDisplay}" Width="135" SortMemberPath="Attributes" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                    <Setter Property="Foreground" Value="#FBBF24"/>
                                    <Setter Property="FontSize" Value="11.5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 更新日時 -->
                        <DataGridTextColumn Header="更新日時" Binding="{Binding ModifiedDate, StringFormat=yyyy/MM/dd HH:mm}" Width="135" SortMemberPath="ModifiedDate" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- フルパス -->
                        <DataGridTextColumn Header="フルパス" Binding="{Binding FullPath}" Width="*" SortMemberPath="FullPath" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- ==================== 下部：ステータスバー ＆ 一括完全削除アクションバー ==================== -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="14,9"
                DataContext="{Binding ActiveTab}">
            <DockPanel>
                <!-- 右側：一括選択＆完全削除アクション -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectionSummary}"
                               VerticalAlignment="Center"
                               Foreground="#38BDF8"
                               FontWeight="SemiBold"
                               FontSize="12.5"
                               Margin="0,0,14,0"/>

                    <Button Style="{StaticResource ModernButton}"
                            Content="🧹 ゴミ・キャッシュ候補を一括チェック"
                            Padding="10,6" Margin="0,0,6,0"
                            Click="SelectAllJunkButton_Click"
                            ToolTip="現在の一覧から一時ファイル・キャッシュ・ログ・インストーラー候補を自動選択します"/>

                    <Button Style="{StaticResource ModernButton}"
                            Content="選択解除"
                            Padding="10,6" Margin="0,0,10,0"
                            Click="ClearSelectionButton_Click"/>

                    <Button Style="{StaticResource DangerButton}"
                            Content="🔥 選択項目を完全削除して容量を空ける"
                            Padding="14,6"
                            Click="DeleteSelectedItemsButton_Click"/>
                </StackPanel>

                <!-- 左側：進捗・ステータス表示 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="80" Height="8" Margin="0,0,10,0"
                                 Foreground="#38BDF8" Background="#1E293B" BorderThickness="0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               Foreground="#CBD5E1"
                               FontSize="12.5"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
