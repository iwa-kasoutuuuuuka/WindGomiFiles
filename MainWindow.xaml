<Window x:Class="WinGomiExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:WinGomiExplorer.Converters"
        xmlns:ctrl="clr-namespace:WinGomiExplorer.Controls"
        mc:Ignorable="d"
        Title="WinGomiExplorer - 容量ソート対応タブ型ファイルエクスプローラー &amp; 大容量ゴミファイルスキャナー"
        Width="1460" Height="900"
        MinWidth="1060" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Background="#0B1120"
        Foreground="#F8FAFC"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <conv:RatioToWidthConverter x:Key="RatioToWidthConverter" MaxWidth="160"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:CategoryToBackgroundConverter x:Key="CategoryBgConverter"/>
        <conv:CategoryToForegroundConverter x:Key="CategoryFgConverter"/>

        <!-- 共通ボタンスタイル -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0369A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PurpleAccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#6D28D9"/>
            <Setter Property="BorderBrush" Value="#A855F7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5B21B6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#F87171"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 上部：ドライブ容量モニター＆統合ツールバー ==================== -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="14,9">
            <DockPanel>
                <!-- アプリタイトル・アイコン -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Image Source="pack://application:,,,/Assets/app_icon.png"
                           Width="38" Height="38"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="WinGomiExplorer" FontSize="16.5" FontWeight="Bold" Foreground="#38BDF8"/>
                            <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Pro Edition" FontSize="10" Foreground="#93C5FD" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="容量ソート・ツリーマップ・重複検出・2画面分割" FontSize="10.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 右側アクションボタン群 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Style="{StaticResource AccentButton}"
                            Content="🔍 Cドライブ大容量スキャン"
                            Padding="10,6" Margin="0,0,6,0"
                            Click="ScanCDriveButton_Click"/>

                    <Button Style="{StaticResource PurpleAccentButton}"
                            Content="🧰 スマートクリーン &amp; 開発キャッシュ診断"
                            Padding="10,6" Margin="0,0,6,0"
                            Click="OpenSmartCleanerButton_Click"
                            ToolTip="npm/pip/cargo/NuGet/Dockerキャッシュ、空フォルダ、WinSxS残骸を一括診断"/>

                    <Button Style="{StaticResource ModernButton}"
                            Content="📊 ツリーマップ切替"
                            Padding="9,6" Margin="0,0,6,0"
                            Click="ToggleVisualDashboardButton_Click"
                            ToolTip="ツリーマップ面積グラフ＆拡張子シェア統計パネルの表示/非表示を切り替えます"/>

                    <Button Style="{StaticResource ModernButton}"
                            Content="🪟 2画面分割 (Dual)"
                            Padding="9,6" Margin="0,0,6,0"
                            Click="ToggleDualPaneButton_Click"
                            ToolTip="左右2画面（デュアルペイン）表示を切り替えます"/>

                    <Button Style="{StaticResource ModernButton}"
                            Content="🔄"
                            Padding="8,6"
                            Click="RefreshDrivesButton_Click"
                            ToolTip="ドライブ空き容量を更新"/>
                </StackPanel>

                <!-- ドライブカード一覧 -->
                <ItemsControl x:Name="DrivesItemsControl" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                    CornerRadius="6" Padding="9,5" Margin="0,0,8,0" Width="245">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="12" Foreground="#F8FAFC"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="開く" Style="{StaticResource ModernButton}"
                                                    Padding="5,1" FontSize="10.5" Margin="0,0,4,0"
                                                    Tag="{Binding RootPath}" Click="OpenDriveButton_Click"/>
                                            <Button Content="🔍スキャン" Style="{StaticResource AccentButton}"
                                                    Padding="5,1" FontSize="10.5"
                                                    Tag="{Binding RootPath}" Click="ScanDriveButton_Click"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar Value="{Binding UsedPercentage, Mode=OneWay}" Maximum="100" Height="5"
                                                 Margin="0,4,0,3" Background="#0F172A" BorderThickness="0">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Foreground" Value="#38BDF8"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLowSpace}" Value="True">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                    <TextBlock Text="{Binding UsageSummary}" FontSize="10" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- ==================== 中央：左サイドバー ＋ メインエリア ＋ デュアルペイン ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="170" MaxWidth="340"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="DualPaneColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- 左サイドバー：クイックアクセス & お気に入りピン留め & 隠しゴミ溜まりスポット -->
            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0" Padding="8">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="2,2,2,8">
                        <TextBlock Text="📌 クイック &amp; 隠し領域"
                                   FontSize="12" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <Button Content="⭐＋固定"
                                Style="{StaticResource ModernButton}"
                                Padding="6,2" FontSize="10.5" HorizontalAlignment="Right"
                                Click="AddCurrentFolderBookmarkButton_Click"
                                ToolTip="現在開いているフォルダを左サイドバーのお気に入りにピン留め追加します"/>
                    </DockPanel>

                    <ListBox x:Name="QuickAccessListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#E2E8F0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseUp="QuickAccessListBox_MouseUp">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,5"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#1E3A8A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel ToolTip="{Binding TargetPath}">
                                    <TextBlock Text="{Binding Icon}" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📂 現在のタブで開く" Click="QuickAccessOpenCurrentTab_Click"/>
                                <MenuItem Header="➕ 新しいタブで開く" Click="QuickAccessOpenNewTab_Click"/>
                                <MenuItem Header="🔍 この場所を大容量スキャン" Click="QuickAccessScan_Click"/>
                                <Separator/>
                                <MenuItem Header="🗑️ お気に入りから削除" Click="QuickAccessRemoveBookmark_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#1E293B"/>

            <!-- ==================== メインペイン（マルチタブ ＋ ツリーマップ ＋ DataGrid） ==================== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. タブバー -->
                <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="8,6,8,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,4">
                            <Button Style="{StaticResource ModernButton}"
                                    Content="📌 タブ固定"
                                    Padding="8,4" FontSize="11.5" Margin="0,0,5,0"
                                    Click="TogglePinActiveTabButton_Click"
                                    ToolTip="現在のタブをピン留め固定します"/>
                            <Button Style="{StaticResource ModernButton}"
                                    Content="＋ 新規タブ (Ctrl+T)"
                                    Padding="8,4" FontSize="11.5" Margin="0,0,5,0"
                                    Click="NewExplorerTabButton_Click"/>
                            <Button Style="{StaticResource AccentButton}"
                                    Content="🔍＋ スキャンタブ"
                                    Padding="8,4" FontSize="11.5"
                                    Click="NewScannerTabButton_Click"/>
                        </StackPanel>

                        <ListBox x:Name="TabsListBox"
                                 ItemsSource="{Binding Tabs}"
                                 SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,4,0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="tabBorder"
                                                        Background="#1E293B"
                                                        BorderBrush="#334155"
                                                        BorderThickness="1,1,1,0"
                                                        CornerRadius="6,6,0,0"
                                                        Padding="11,5"
                                                        Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="tabBorder" Property="Background" Value="#0284C7"/>
                                                        <Setter TargetName="tabBorder" Property="BorderBrush" Value="#38BDF8"/>
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                            <Condition Property="IsSelected" Value="False"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="tabBorder" Property="Background" Value="#334155"/>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" MaxWidth="230">
                                        <TextBlock Text="{Binding HeaderTitle}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="185"
                                                   ToolTip="{Binding CurrentPath}"/>
                                        <Button Content="✕"
                                                Margin="7,0,0,0"
                                                Padding="3,0"
                                                Background="Transparent"
                                                Foreground="#E2E8F0"
                                                BorderThickness="0"
                                                FontSize="10.5"
                                                Cursor="Hand"
                                                Tag="{Binding}"
                                                Click="CloseTabButton_Click"
                                                ToolTip="タブを閉じる"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- 2. ナビゲーション＆アドレスバー -->
                <Border Grid.Row="1" Background="#162032" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="10,7"
                        DataContext="{Binding ActiveTab}">
                    <Grid>
                        <!-- フォルダ閲覧タブ用 -->
                        <DockPanel Visibility="{Binding IsExplorerTab, Converter={StaticResource BoolToVis}}">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,8,0">
                                <Button Style="{StaticResource ModernButton}" Content="⬅" Width="32" Margin="0,0,4,0"
                                        IsEnabled="{Binding CanGoBack}" Click="BackButton_Click" ToolTip="戻る (Alt+Left)"/>
                                <Button Style="{StaticResource ModernButton}" Content="➡" Width="32" Margin="0,0,4,0"
                                        IsEnabled="{Binding CanGoForward}" Click="ForwardButton_Click" ToolTip="進む (Alt+Right)"/>
                                <Button Style="{StaticResource ModernButton}" Content="⬆ 上へ" Padding="8,4" Margin="0,0,4,0"
                                        IsEnabled="{Binding CanGoUp}" Click="UpButton_Click" ToolTip="上の階層へ (Alt+Up)"/>
                                <Button Style="{StaticResource ModernButton}" Content="🔄 再計算" Padding="8,4"
                                        Click="RefreshExplorerButton_Click" ToolTip="最新状態に更新しフォルダ容量を再計算 (F5)"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Style="{StaticResource ModernButton}" Content="移動" Padding="10,4" Margin="0,0,5,0"
                                        Click="NavigateAddressButton_Click"/>
                                <Button Style="{StaticResource ModernButton}" Content="👁️ プレビュー (Space)" Padding="9,4" Margin="0,0,5,0"
                                        Click="QuickPreviewButton_Click"/>
                                <Button Style="{StaticResource ModernButton}" Content="✏️ 一括リネーム (F2)" Padding="9,4" Margin="0,0,5,0"
                                        Click="BatchRenameButton_Click"/>
                                <Button Style="{StaticResource AccentButton}" Content="🔍 この場所をスキャン" Padding="10,4"
                                        Click="ScanCurrentFolderButton_Click"/>
                            </StackPanel>

                            <TextBox x:Name="ExplorerAddressTextBox"
                                     Text="{Binding AddressBarText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"
                                     Padding="8,4" FontSize="12.5" VerticalContentAlignment="Center"
                                     KeyDown="ExplorerAddressTextBox_KeyDown"/>
                        </DockPanel>

                        <!-- 大容量・ゴミファイルスキャンタブ用 -->
                        <DockPanel Visibility="{Binding IsScannerTab, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Left" Text="🎯 スキャン対象パス:" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,8,0"/>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Style="{StaticResource ModernButton}" Content="👁️ プレビュー (Space)" Padding="9,4" Margin="0,0,5,0"
                                        Click="QuickPreviewButton_Click"/>
                                <Button Style="{StaticResource AccentButton}" Content="🚀 スキャン開始 / 再スキャン" Padding="12,4" Margin="0,0,5,0"
                                        Click="StartScanButton_Click"/>
                                <Button Style="{StaticResource DangerButton}" Content="⏹ 停止" Padding="10,4"
                                        IsEnabled="{Binding IsBusy}" Click="StopScanButton_Click"/>
                            </StackPanel>

                            <TextBox Text="{Binding AddressBarText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#38BDF8"
                                     Padding="8,4" FontSize="12.5" VerticalContentAlignment="Center"
                                     KeyDown="ScannerAddressTextBox_KeyDown"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- 3. ソート・フィルタ・モード切替バー -->
                <Border Grid.Row="2" Background="#111827" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="10,6"
                        DataContext="{Binding ActiveTab}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔎 絞り込み:" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11.5" Margin="0,0,5,0"/>
                            <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                     Width="195" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"
                                     Padding="6,3" FontSize="12" VerticalContentAlignment="Center"
                                     ToolTip="ファイル名・拡張子・パス・判定ラベルでリアルタイム絞り込み"/>
                            <Button Content="✕" Style="{StaticResource ModernButton}" Padding="5,2" Margin="3,0,0,0"
                                    Click="ClearSearchFilterButton_Click" ToolTip="検索条件をクリア"/>
                        </StackPanel>

                        <!-- エクスプローラータブ用ソートバー -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsExplorerTab, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="並び替え:" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11.5" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource AccentButton}" Content="⬇ 容量が大きい順"
                                    Padding="9,3" Margin="0,0,4,0" FontSize="11.5" Click="SortBySizeDescButton_Click"/>
                            <Button Style="{StaticResource ModernButton}" Content="🔤 名前順"
                                    Padding="7,3" Margin="0,0,4,0" FontSize="11.5" Click="SortByNameButton_Click"/>
                            <Button Style="{StaticResource ModernButton}" Content="🏷️ 拡張子順"
                                    Padding="7,3" Margin="0,0,4,0" FontSize="11.5" Click="SortByExtensionButton_Click"/>
                            <Button Style="{StaticResource ModernButton}" Content="🕒 更新日時順"
                                    Padding="7,3" Margin="0,0,10,0" FontSize="11.5" Click="SortByDateButton_Click"/>

                            <CheckBox IsChecked="{Binding SortFoldersFirst}"
                                      Content="フォルダを上部にまとめる"
                                      Foreground="#E2E8F0" VerticalAlignment="Center" FontSize="11.5" Margin="0,0,10,0"/>

                            <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="✓ 拡張子・隠し(H)・システム(S) 全表示" FontSize="10.5" Foreground="#6EE7B7"/>
                            </Border>
                        </StackPanel>

                        <!-- 大容量スキャンタブ用フィルタバー -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsScannerTab, Converter={StaticResource BoolToVis}}">
                            <RadioButton Content="📄 巨大ファイル"
                                         IsChecked="{Binding IsLargeFilesMode}"
                                         Foreground="#F8FAFC" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <RadioButton Content="📁 巨大フォルダ"
                                         IsChecked="{Binding IsLargeFoldersMode}"
                                         Foreground="#F8FAFC" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <RadioButton Content="🧹 ゴミ・キャッシュ候補"
                                         IsChecked="{Binding IsJunkMode}"
                                         Foreground="#FBBF24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <RadioButton Content="🧬 重複ファイル (同一内容)"
                                         IsChecked="{Binding IsDuplicatesMode}"
                                         Foreground="#C084FC" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0"/>

                            <TextBlock Text="最小サイズ:" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11.5" Margin="0,0,5,0"/>
                            <ComboBox ItemsSource="{Binding ThresholdOptions}"
                                      SelectedValue="{Binding MinSizeThresholdBytes}"
                                      SelectedValuePath="Bytes"
                                      DisplayMemberPath="Label"
                                      Width="135" FontSize="11.5" Padding="5,2"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 4. 📊 ツリーマップ (Treemap) & 拡張子別シェア統計ダッシュボード -->
                <Border Grid.Row="3"
                        x:Name="VisualDashboardPanel"
                        Background="#0F172A"
                        BorderBrush="#1E293B"
                        BorderThickness="0,0,0,1"
                        Height="175"
                        Padding="10,6"
                        DataContext="{Binding ActiveTab}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左：インタラクティブ ツリーマップ -->
                        <DockPanel Grid.Column="0">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <TextBlock Text="📊 容量ツリーマップ (面積＝ファイル/フォルダ容量  |  クリックで選択・ダブルクリックで開く)"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            </DockPanel>
                            <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="4">
                                <ctrl:TreemapControl x:Name="MainTreemapControl"
                                                     ItemsSource="{Binding TreemapItems}"
                                                     ItemClicked="Treemap_ItemClicked"
                                                     ItemDoubleClicked="Treemap_ItemDoubleClicked"/>
                            </Border>
                        </DockPanel>

                        <!-- 右：拡張子・種別シェア Top 8 -->
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="📈 拡張子・種別シェア Top 8 (クリックで絞込)"
                                       FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <Border Background="#162032" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                <ItemsControl ItemsSource="{Binding ExtensionStats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1.5">
                                                <ProgressBar Value="{Binding Percentage, Mode=OneWay}" Maximum="100" Height="16"
                                                             Background="#0F172A" Foreground="#1E3A8A" BorderThickness="0"/>
                                                <Button Content="{Binding DisplayText}"
                                                        Tag="{Binding Extension}"
                                                        Background="Transparent" Foreground="#E2E8F0" BorderThickness="0"
                                                        HorizontalContentAlignment="Left" Padding="6,0" FontSize="11"
                                                        Cursor="Hand" Click="ExtensionStatFilterButton_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- 5. メイン DataGrid -->
                <DataGrid Grid.Row="4"
                          x:Name="ItemsDataGrid"
                          DataContext="{Binding ActiveTab}"
                          ItemsSource="{Binding DisplayedItems}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="False"
                          SelectionMode="Extended"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#1E293B"
                          Background="#0B1120"
                          RowBackground="#0F172A"
                          AlternatingRowBackground="#131C31"
                          Foreground="#F1F5F9"
                          BorderThickness="0"
                          RowHeight="31"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          Sorting="ItemsDataGrid_Sorting"
                          MouseDoubleClick="ItemsDataGrid_MouseDoubleClick">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="Foreground" Value="#CBD5E1"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1E3A8A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="👁️ クイックプレビュー (Space)" Click="QuickPreviewButton_Click" FontWeight="SemiBold"/>
                            <MenuItem Header="📂 開く / フォルダへ移動" Click="ContextOpen_Click"/>
                            <MenuItem Header="➕ 新しいタブでこの場所を開く" Click="ContextOpenInNewTab_Click"/>
                            <MenuItem Header="🔍 このフォルダを大容量スキャン" Click="ContextScanFolder_Click"/>
                            <Separator/>
                            <MenuItem Header="✏️ 選択項目を一括リネーム (F2)..." Click="BatchRenameButton_Click"/>
                            <MenuItem Header="⭐ このフォルダをお気に入りにピン留め" Click="ContextBookmarkFolder_Click"/>
                            <MenuItem Header="📋 フルパスをコピー" Click="ContextCopyPath_Click"/>
                            <MenuItem Header="🪟 Windows標準エクスプローラーで場所を開く" Click="ContextRevealInExplorer_Click"/>
                            <Separator/>
                            <MenuItem Header="🔥 この項目を完全削除する..." Foreground="#DC2626" FontWeight="Bold" Click="ContextDeletePermanent_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="選択" Width="44" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsSystemProtected, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="名前 (拡張子常時表示)" Width="270" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                        <TextBlock Text="{Binding IconSymbol}" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FullPath}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#F8FAFC"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                            <Setter Property="Foreground" Value="#93C5FD"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="拡張子" Binding="{Binding Extension}" Width="80" SortMemberPath="Extension" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                    <Setter Property="Foreground" Value="#38BDF8"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="容量 (サイズ順ソート)" Width="175" SortMemberPath="Size">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,3" VerticalAlignment="Center">
                                        <Border HorizontalAlignment="Left"
                                                Width="{Binding SizeRatio, Converter={StaticResource RatioToWidthConverter}}"
                                                Height="19"
                                                CornerRadius="3"
                                                Background="#3B0764"
                                                BorderBrush="#A855F7"
                                                BorderThickness="1"
                                                Opacity="0.65"/>
                                        <TextBlock Text="{Binding SizeDisplay}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,8,0"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Foreground="#F8FAFC"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="種別・ゴミ・重複判定" Width="165" SortMemberPath="Category">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Category, Converter={StaticResource CategoryBgConverter}}"
                                            CornerRadius="4" Padding="7,2" Margin="6,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CategoryLabel}"
                                                   Foreground="{Binding Category, Converter={StaticResource CategoryFgConverter}}"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="属性 (H/S/R/L)" Binding="{Binding AttributesDisplay}" Width="125" SortMemberPath="Attributes" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                    <Setter Property="Foreground" Value="#FBBF24"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="更新日時" Binding="{Binding ModifiedDate, StringFormat=yyyy/MM/dd HH:mm}" Width="125" SortMemberPath="ModifiedDate" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontSize" Value="11.5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="フルパス" Binding="{Binding FullPath}" Width="*" SortMemberPath="FullPath" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ==================== デュアルペイン転送バー & 第2ペイン (Split View) ==================== -->
            <Border Grid.Column="3"
                    x:Name="DualPaneTransferBar"
                    Visibility="Collapsed"
                    Background="#0F172A"
                    BorderBrush="#1E293B"
                    BorderThickness="1,0,1,0"
                    Padding="4">
                <StackPanel VerticalAlignment="Center">
                    <Button Style="{StaticResource AccentButton}" Content="➡ コピー" Padding="6,6" Margin="0,0,0,8" FontSize="11"
                            Click="CopyToSecondaryPaneButton_Click" ToolTip="左ペインで選択した項目を右ペインのフォルダへコピー"/>
                    <Button Style="{StaticResource ModernButton}" Content="➡ 移動" Padding="6,6" Margin="0,0,0,20" FontSize="11"
                            Click="MoveToSecondaryPaneButton_Click" ToolTip="左ペインで選択した項目を右ペインのフォルダへ移動"/>
                    <Button Style="{StaticResource AccentButton}" Content="⬅ コピー" Padding="6,6" Margin="0,0,0,8" FontSize="11"
                            Click="CopyToPrimaryPaneButton_Click" ToolTip="右ペインで選択した項目を左ペインのフォルダへコピー"/>
                    <Button Style="{StaticResource ModernButton}" Content="⬅ 移動" Padding="6,6" FontSize="11"
                            Click="MoveToPrimaryPaneButton_Click" ToolTip="右ペインで選択した項目を左ペインのフォルダへ移動"/>
                </StackPanel>
            </Border>

            <!-- 第2ペイン (右ペイン) -->
            <Border Grid.Column="4"
                    x:Name="DualPaneContainer"
                    Visibility="Collapsed"
                    Background="#0B1120"
                    DataContext="{Binding SecondaryTab}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 右ペイン ヘッダー -->
                    <Border Grid.Row="0" Background="#162032" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="8,7">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="🪟 第2ペイン:" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ModernButton}" Content="✕ 閉じる" Padding="7,3" Margin="6,0,0,0"
                                    Click="ToggleDualPaneButton_Click"/>
                            <TextBlock Text="{Binding CurrentPath}" Foreground="#CBD5E1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>

                    <!-- 右ペイン ナビゲーション -->
                    <Border Grid.Row="1" Background="#111827" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="8,6">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,6,0">
                                <Button Style="{StaticResource ModernButton}" Content="⬅" Width="28" Margin="0,0,3,0" IsEnabled="{Binding CanGoBack}" Click="SecondaryBackButton_Click"/>
                                <Button Style="{StaticResource ModernButton}" Content="⬆" Width="28" Margin="0,0,3,0" IsEnabled="{Binding CanGoUp}" Click="SecondaryUpButton_Click"/>
                                <Button Style="{StaticResource ModernButton}" Content="🔄" Width="28" Click="SecondaryRefreshButton_Click"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ModernButton}" Content="移動" Padding="8,3" Margin="6,0,0,0" Click="SecondaryNavigateButton_Click"/>
                            <TextBox Text="{Binding AddressBarText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="6,3" VerticalContentAlignment="Center"
                                     KeyDown="SecondaryAddressTextBox_KeyDown"/>
                        </DockPanel>
                    </Border>

                    <!-- 右ペイン DataGrid -->
                    <DataGrid Grid.Row="2"
                              x:Name="SecondaryDataGrid"
                              ItemsSource="{Binding DisplayedItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="False"
                              HeadersVisibility="Column"
                              Background="#0B1120"
                              RowBackground="#0F172A"
                              AlternatingRowBackground="#131C31"
                              Foreground="#F1F5F9"
                              BorderThickness="0"
                              RowHeight="29"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1E293B"
                              MouseDoubleClick="SecondaryDataGrid_MouseDoubleClick">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="選択" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="種別" Binding="{Binding IconSymbol}" Width="42" IsReadOnly="True"/>
                            <DataGridTextColumn Header="名前" Binding="{Binding Name}" Width="190" IsReadOnly="True"/>
                            <DataGridTextColumn Header="容量" Binding="{Binding SizeDisplay}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="属性" Binding="{Binding AttributesDisplay}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 右ペイン ステータス -->
                    <Border Grid.Row="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="8,5">
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 下部：ステータスバー ＆ 一括完全削除アクションバー ==================== -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="14,8"
                DataContext="{Binding ActiveTab}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectionSummary}"
                               VerticalAlignment="Center"
                               Foreground="#38BDF8"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="0,0,12,0"/>

                    <Button Style="{StaticResource ModernButton}"
                            Content="🧹 ゴミ・重複コピーを一括チェック"
                            Padding="10,5" Margin="0,0,6,0"
                            Click="SelectAllJunkButton_Click"/>

                    <Button Style="{StaticResource ModernButton}"
                            Content="選択解除"
                            Padding="10,5" Margin="0,0,10,0"
                            Click="ClearSelectionButton_Click"/>

                    <Button Style="{StaticResource DangerButton}"
                            Content="🔥 選択項目を完全削除して容量を空ける"
                            Padding="14,5"
                            Click="DeleteSelectedItemsButton_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="75" Height="7" Margin="0,0,10,0"
                                 Foreground="#38BDF8" Background="#1E293B" BorderThickness="0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               Foreground="#CBD5E1"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
