<Window x:Class="WinGomiExplorer.Views.QuickPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="👁️ クイックプレビュー (Space / Esc で閉じる)"
        Width="860" Height="620"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Background="#0B1120"
        Foreground="#F8FAFC"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー情報 -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0284C7" CornerRadius="5" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock x:Name="SizeBadgeText" Text="0 B" FontSize="13.5" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <Border Background="#334155" CornerRadius="5" Padding="10,4">
                        <TextBlock x:Name="CategoryBadgeText" Text="通常" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="ファイル名" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PathText" Text="C:\" FontSize="11.5" Foreground="#94A3B8" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- メタデータバー -->
        <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,7" Margin="0,8,0,8">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        x:Name="ComputeHashButton"
                        Content="🔑 SHA-256 ハッシュ計算"
                        Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1"
                        Padding="8,3" FontSize="11.5" Cursor="Hand"
                        Click="ComputeHashButton_Click"/>
                <TextBlock x:Name="MetadataText"
                           Text="更新日時: - | 属性: -"
                           FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- メインプレビュー領域 (テキスト / 画像 / Hexダンプ / フォルダ内訳) -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="8">
            <Grid>
                <!-- テキスト・Hex・フォルダサマリー表示用 -->
                <TextBox x:Name="PreviewTextBox"
                         IsReadOnly="True"
                         Background="Transparent"
                         Foreground="#E2E8F0"
                         BorderThickness="0"
                         FontFamily="Consolas, Yu Gothic UI"
                         FontSize="12.5"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         AcceptsReturn="True"/>

                <!-- 画像プレビュー表示用 -->
                <ScrollViewer x:Name="ImageScrollViewer" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image x:Name="PreviewImage" Stretch="Uniform" MaxWidth="800" MaxHeight="440" RenderOptions.BitmapScalingMode="HighQuality"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- フッター -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="PreviewModeHintText"
                       Text="ヒント: Space キーまたは Esc キーで即座に閉じます"
                       Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="📋 パスをコピー"
                        Width="120" Height="34" Margin="0,0,8,0"
                        Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                        Cursor="Hand" Click="CopyPathButton_Click"/>
                <Button Content="閉じる (Space / Esc)"
                        Width="150" Height="34"
                        Background="#0284C7" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand" Click="CloseButton_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
