<Window x:Class="WinGomiExplorer.Views.SmartCleanerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🧰 スマートクリーン &amp; 開発キャッシュ・空フォルダ・システム診断"
        Width="980" Height="660"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Background="#0B1120"
        Foreground="#F8FAFC">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="🧰 スマートクリーンアップ &amp; 開発ツールキャッシュ・空フォルダ診断"
                           FontSize="17" FontWeight="Bold" Foreground="#38BDF8"/>
                <TextBlock Text="Cドライブを圧迫しやすい開発ツールキャッシュ (npm/pip/cargo/NuGet/Docker)、ブラウザ/GPUキャッシュ、空フォルダ・0バイトファイル、WinSxS残骸を診断・整理します。"
                           FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- モード切替ツールバー -->
        <Border Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="🔧 1. 開発ツール &amp; システムキャッシュ一括診断"
                            Background="#0284C7" Foreground="White" FontWeight="SemiBold" BorderThickness="0"
                            Padding="12,6" Margin="0,0,8,0" Cursor="Hand"
                            Click="ScanDevCachesButton_Click"/>

                    <Button Content="📂 2. 空フォルダ・0バイトファイル検出"
                            Background="#334155" Foreground="White" FontWeight="SemiBold" BorderThickness="0"
                            Padding="12,6" Margin="0,0,8,0" Cursor="Hand"
                            Click="ScanEmptyFoldersButton_Click"/>

                    <Button Content="🛡️ 3. WinSxS / アップデート残骸レポート"
                            Background="#334155" Foreground="#FBBF24" FontWeight="SemiBold" BorderThickness="0"
                            Padding="12,6" Cursor="Hand"
                            Click="RunWindowsDiagButton_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="対象フォルダ (空フォルダ検出用):" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11.5" Margin="8,0,6,0"/>
                    <TextBox x:Name="TargetFolderTextBox" Width="210" Background="#0F172A" Foreground="White" BorderBrush="#475569" Padding="6,4" VerticalContentAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- メインリスト / レポート領域 -->
        <Grid Grid.Row="2">
            <DataGrid x:Name="ResultsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      Background="#0F172A"
                      RowBackground="#0F172A"
                      AlternatingRowBackground="#162032"
                      Foreground="#F8FAFC"
                      BorderBrush="#334155"
                      BorderThickness="1"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#1E293B"
                      MouseDoubleClick="ResultsGrid_MouseDoubleClick">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1E293B"/>
                        <Setter Property="Foreground" Value="#CBD5E1"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="選択" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="種別・項目" Binding="{Binding CategoryLabel}" Width="220" IsReadOnly="True"/>
                    <DataGridTextColumn Header="容量" Binding="{Binding SizeDisplay}" Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="ファイル数" Binding="{Binding FileCount}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="フルパス (ダブルクリックでメインタブ展開)" Binding="{Binding FullPath}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBox x:Name="DiagReportTextBox"
                     Visibility="Collapsed"
                     IsReadOnly="True"
                     Background="#0F172A"
                     Foreground="#E2E8F0"
                     BorderBrush="#334155"
                     BorderThickness="1"
                     Padding="12"
                     FontFamily="Consolas, Yu Gothic UI"
                     FontSize="12.5"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"/>
        </Grid>

        <!-- フッター -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Text="準備完了" VerticalAlignment="Center" Foreground="#38BDF8" FontWeight="SemiBold"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="📂 選択した場所をタブで開く"
                        Height="36" Padding="14,0" Margin="0,0,10,0"
                        Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Click="OpenSelectedInTabButton_Click"/>

                <Button Content="🔥 チェックしたキャッシュ/空フォルダの中身を完全クリーンアップ"
                        Height="36" Padding="16,0" Margin="0,0,10,0"
                        Background="#DC2626" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Click="CleanSelectedButton_Click"/>

                <Button Content="閉じる"
                        Width="100" Height="36"
                        Background="#1E293B" Foreground="White" BorderBrush="#475569" BorderThickness="1" Cursor="Hand"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
